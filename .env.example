# Postgres connection (Supabase pooler URL or local). Required by ingest + dashboard.
TCA_DATABASE_URL=postgresql://user:pass@host:6543/postgres

# Alchemy archive endpoint for Base mainnet. debug_traceTransaction + eth_call
# at historical block heights require an archive plan.
TCA_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional: explicit poll interval (ms). Defaults to 2000.
# TCA_POLL_INTERVAL_MS=2000

# Optional: cold-start P99 floor in USD. Defaults to 500000.
# TCA_COLD_START_FLOOR_USD=500000

# v1 "Aggregator Benchmark" Supabase DB — READ ONLY (source of smoke-test txs)
V1_DATABASE_URL=postgresql://user:pass@host:6543/postgres

# Trader EOA used for v1 smoke-test experiments. The v1 DB does not store the
# trader address in runs.intent (it only has pair/size/direction). Set this to
# the address derived from TCA_EOA_PRIVATE_KEY in the v1 .env.
SMOKE_TRADER=0x0000000000000000000000000000000000000000

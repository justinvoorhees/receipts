{
	"name": "fabric-tca-decoder",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "npm --workspace packages/dashboard run dev",
		"lint": "eslint packages",
		"typecheck": "tsc --build",
		"test": "vitest run",
		"build": "tsc --build && npm --workspace packages/dashboard run build",
		"start": "npm --workspace packages/dashboard run start",
		"etl:ingest": "tsc --build && node packages/etl/dist/cli.js",
		"settlers:refresh": "tsc --build && node packages/core/dist/scripts/refreshSettlers.js",
		"reactors:refresh": "tsc --build && node packages/core/dist/scripts/refreshReactors.js",
		"aggregators:coverage": "tsc --build && node packages/core/dist/scripts/reportAggregatorCoverage.js"
	},
	"devDependencies": {
		"@types/node": "^20.14.0",
		"eslint": "^9.0.0",
		"prettier": "^3.3.0",
		"typescript": "^5.4.0",
		"typescript-eslint": "^8.60.1",
		"vitest": "^2.0.0"
	}
}
